# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
.venv
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Ruff
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# ML artifacts (large files — use DVC or git-lfs)
*.pt
*.pth
*.ckpt
*.safetensors
wandb/

# patch-encoder corpus-assembly cache (scratch — belongs on /work/projects/imas_gpu/...;
# this in-repo path is only a same-filesystem fallback when that mount is absent, e.g.
# from some `sun`-partition compute nodes)
imas_ambix/latent/artifacts/patch_encoder/corpus_cache/

# patch-basis Green's cache, computed on first use per geometry key and grid size and
# reused thereafter. Its default directory is a RELATIVE path, so the file lands in
# whatever directory the run was launched from — the repo root for any benchmark or
# gate run — at a couple of hundred megabytes each. It is derived from the geometry it
# is keyed by and can always be recomputed, so it must never be committable.
imas_ambix/latent/artifacts/patch_scoping/

# Data (tracked separately) — anchored to repo root so it doesn't
# shadow imas_ambix/data/ (the FAIR-MAST acquisition Python package).
/data/

# Environment
.env
.env.local

# SLURM logs
ambix-serve-*.log
ambix-download-*.log
diag-*.log
diag2-*.log
slurm-*.out

# Hydra runtime outputs (generated by imas_ambix.train.loop)
outputs/

# Reference papers (large binary PDFs — not tracked in git)
/references/

# reckon writes per-resource lock files here; they are machine-local run state,
# not content, and a committed lock is a stale claim on another checkout.
docs/.reckon/locks/

# Fleet and experiment scratch written beside the source tree. Nothing here is
# input to a build or a test: these are run logs, snapshot directories and
# per-experiment scratch that a session left where it worked. They are ignored
# rather than removed because they are another session's evidence, and walking
# them costs every `git status` in this checkout -- measured 2026-09-23 at 2,116
# untracked entries, 4.3s against 2.9s with the walk excluded, on every call
# including the ones inside a promotion.
_spine_label_fleet_logs/
_prefix_artifacts_snapshot/
_matrix/
scratchpad_*/
_*.log
