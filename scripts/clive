#!/usr/bin/env bash
# clive — drive an agent CLI against the GPU-served local model.
#
# "clive" = CLI + live (GPU-served local Claude/Codex). It points Claude Code
# or the Codex CLI at the vLLM server running on the H200 node, which exposes
# BOTH the Anthropic Messages API (/v1/messages) and the OpenAI API
# (/v1/chat/completions) on the same port — so the same server, key, and model
# back either harness with full reasoning, tool calling, and prompt caching
# (vLLM automatic prefix caching; >0.17.1 handles Claude Code's per-request
# hash, so caching is not defeated).
#
# Usage:
#   clive [--claude|--codex] [agent-args...]
#   clive "explain this repo"            # Claude Code (default)
#   clive --codex "write a test"         # OpenAI Codex CLI
#   clive --url http://host:PORT ...     # override endpoint
#
# The API key is never placed on a command line: it is read from the shared
# mode-640 key file into an env var the agent reads natively. Distribute access
# by group membership (sdcc-imas_gpu), not by copying the key.

set -euo pipefail

# ── Defaults (override via env or flags) ─────────────────────────────────────
AMBIX_URL="${AMBIX_AGENT_URL:-http://98dci4-gpu-0003:18800}"
AMBIX_MODEL="${AMBIX_AGENT_MODEL:-glm-5.2-fp8}"
AMBIX_KEY_FILE="${AMBIX_AGENT_KEY_FILE:-/work/projects/imas_gpu/agents/.env}"
HARNESS="claude"

usage() {
    cat >&2 <<'USAGE'
clive — drive an agent CLI against the GPU-served local model.

  clive [--claude|--codex] [--url URL] [--model NAME] [agent-args...]

  --claude        Use Claude Code via the Anthropic Messages API (default).
  --codex         Use the OpenAI Codex CLI via the OpenAI API.
  --url URL       Server base URL (default $AMBIX_AGENT_URL or the H200 node).
  --model NAME    Served model name (default $AMBIX_AGENT_MODEL).
  -h, --help      Show this help.

Anything after a `--`, or any unrecognised argument, is passed to the agent.
Env overrides: AMBIX_AGENT_URL, AMBIX_AGENT_MODEL, AMBIX_AGENT_KEY_FILE,
AMBIX_AGENT_API_KEY.
USAGE
}

# ── Parse clive's own flags; pass everything else to the agent ───────────────
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --claude) HARNESS="claude"; shift ;;
        --codex)  HARNESS="codex";  shift ;;
        --url)    AMBIX_URL="$2";   shift 2 ;;
        --model)  AMBIX_MODEL="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; ARGS+=("$@"); break ;;
        *)  ARGS+=("$1"); shift ;;
    esac
done

# ── Resolve the API key (file > AMBIX_AGENT_API_KEY env) without echoing it ──
read_key() {
    if [[ -n "${AMBIX_AGENT_API_KEY:-}" ]]; then
        printf '%s' "$AMBIX_AGENT_API_KEY"
        return 0
    fi
    if [[ ! -r "$AMBIX_KEY_FILE" ]]; then
        echo "clive: cannot read key file: $AMBIX_KEY_FILE" >&2
        echo "       (need membership in the file's group, or set AMBIX_AGENT_API_KEY)" >&2
        return 1
    fi
    # AMBIX_AGENT_API_KEY=<value>, ignoring comments/quotes
    local line
    line="$(grep -E '^[[:space:]]*AMBIX_AGENT_API_KEY[[:space:]]*=' "$AMBIX_KEY_FILE" | tail -1)"
    if [[ -z "$line" ]]; then
        echo "clive: no AMBIX_AGENT_API_KEY in $AMBIX_KEY_FILE" >&2
        return 1
    fi
    line="${line#*=}"
    line="${line%\"}"; line="${line#\"}"
    line="${line%\'}"; line="${line#\'}"
    printf '%s' "$line"
}

KEY="$(read_key)" || exit 1

# ── Launch the chosen harness ────────────────────────────────────────────────
case "$HARNESS" in
    claude)
        if ! command -v claude >/dev/null 2>&1; then
            echo "clive: 'claude' (Claude Code) not on PATH — install it per-user:" >&2
            echo "       https://docs.claude.com/en/docs/claude-code/setup" >&2
            exit 127
        fi
        # Claude Code speaks the Anthropic Messages API → vLLM /v1/messages.
        # Pin every tier to the one local model so Claude Code never requests a
        # model the server doesn't serve. ANTHROPIC_API_KEY is blanked so the
        # AUTH_TOKEN (Bearer) path is used, matching the server's --api-key.
        ANTHROPIC_BASE_URL="$AMBIX_URL" \
        ANTHROPIC_AUTH_TOKEN="$KEY" \
        ANTHROPIC_API_KEY="" \
        ANTHROPIC_DEFAULT_OPUS_MODEL="$AMBIX_MODEL" \
        ANTHROPIC_DEFAULT_SONNET_MODEL="$AMBIX_MODEL" \
        ANTHROPIC_DEFAULT_HAIKU_MODEL="$AMBIX_MODEL" \
        ANTHROPIC_MODEL="$AMBIX_MODEL" \
        CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
        exec claude "${ARGS[@]}"
        ;;
    codex)
        if ! command -v codex >/dev/null 2>&1; then
            echo "clive: 'codex' (Codex CLI) not on PATH — install it per-user:" >&2
            echo "       npm install -g @openai/codex   (needs Node >= 18)" >&2
            exit 127
        fi
        # Codex speaks the OpenAI API → vLLM /v1/chat/completions on the same
        # port. Codex reads OPENAI_BASE_URL / OPENAI_API_KEY.
        OPENAI_BASE_URL="${AMBIX_URL%/}/v1" \
        OPENAI_API_KEY="$KEY" \
        exec codex --model "$AMBIX_MODEL" "${ARGS[@]}"
        ;;
    *)
        echo "clive: unknown harness '$HARNESS'" >&2
        exit 2
        ;;
esac
